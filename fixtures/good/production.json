    "Topic": {"Type":"AWS::SNS::Topic","Properties":{"KmsMasterKeyId":"alias/aws/sns"}},
    "Cache": {"Type":"AWS::ElastiCache::ReplicationGroup","Properties":{"TransitEncryptionEnabled":true,"AtRestEncryptionEnabled":true,"AutomaticFailoverEnabled":true}},
