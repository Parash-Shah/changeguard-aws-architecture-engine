    "Orders": {"Type":"AWS::DynamoDB::Table","Properties":{"PointInTimeRecoverySpecification":{"PointInTimeRecoveryEnabled":true},"DeletionProtectionEnabled":true}},
    "Workers": {"Type":"AWS::AutoScaling::AutoScalingGroup","Properties":{"MinSize":2,"MaxSize":4}},
    "Service": {"Type":"AWS::ECS::Service","Properties":{"DesiredCount":2,"DeploymentConfiguration":{"DeploymentCircuitBreaker":{"Enable":true,"Rollback":true}},"CapacityProviderStrategy":[{"CapacityProvider":"FARGATE_SPOT","Weight":1}]}},
    "Logs": {"Type":"AWS::Logs::LogGroup","Properties":{"RetentionInDays":30}},
