{
  "title": "ChangeGuard",
  "uid": "changeguard",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Reviews per day",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(changeguard_reviews_total[1d]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Average architecture score",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(architecture_score_sum[5m])) / sum(rate(architecture_score_count[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Review latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(review_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Findings by pillar",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pillar) (increase(changeguard_findings_total[1h]))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Critical findings",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(changeguard_critical_findings_total[1h]))"
        }
      ]
    },
    {
      "id": 6,
      "title": "Gate failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(policy_gate_failures_total[1h]))"
        }
      ]
    },
    {
      "id": 7,
      "title": "Regressions detected",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(regressions_detected_total[1h]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "Suppressed findings",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(suppressed_findings_total[1h]))"
        }
      ]
    },
    {
      "id": 9,
      "title": "Most violated rules (unsuppressed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (rule) (increase(changeguard_findings_total{outcome=\"FAIL\",suppressed=\"false\"}[1h])))",
          "legendFormat": "{{rule}}"
        }
      ]
    }
  ]
}
